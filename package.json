{
  "name": "app_configs",
  "version": "1.0.0",
  "main": "index.js",
  "bin": {
    "app_config": "./bin/app_config.js"
  },
  "scripts": {
    "dev": "npm run migration:run && npx tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migration:generate": "node src/scripts/migration-generate.js",
    "migration:run": "node src/scripts/migration-run.js",
    "migration:revert": "node src/scripts/migration-revert.js",
    "token:new": "node -e \"const len=parseInt(process.argv[1]||32); console.log(require('crypto').randomBytes(len).toString('hex'))\"",
    "enum:convert:error-response": "npx tsx src/scripts/convert-enum-error.ts",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "prepush": "npm run lint && npm run typecheck",
    "cli": "npx tsx src/cli/index.ts",
    "app": "npm run cli --",
    "test": "set RUN_FULL_TEST=true && vitest --run",
    "test:watch": "vitest --watch",
    "clean": "rimraf dist",
    "clean:system": "npx tsx src/scripts/clean-system.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "bash -c 'eslint --fix --max-warnings=0'"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.12.2",
    "bullmq": "^5.61.2",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "key-rotation-manager": "^1.1.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "redis": "^5.8.3",
    "reflect-metadata": "^0.2.2",
    "transliteration": "^2.3.5",
    "tsup": "^8.5.1",
    "typeorm": "^0.3.27",
    "typescript-eslint": "^8.46.0",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "wrap-ansi": "^9.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.4",
    "@types/redis": "^4.0.10",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
